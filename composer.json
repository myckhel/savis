{
  "name": "laravel/laravel",
  "type": "project",
  "description": "The Laravel Framework.",
  "keywords": [
    "framework",
    "laravel"
  ],
  "license": "MIT",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/stojankukrika/laravel-paystack"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-gd": "^8.0",
    "inertiajs/inertia-laravel": "^2",
    "intervention/image": "^3",
    "james-heinrich/getid3": "^2",
    "laravel/framework": "^11",
    "laravel/horizon": "^5.31",
    "laravel/octane": "^2",
    "laravel/sanctum": "^4",
    "laravel/telescope": "^5.5",
    "laravel/tinker": "^2.10",
    "myckhel/laravel-chat-system": "^1.0@beta",
    "predis/predis": "^1.1",
    "spatie/laravel-medialibrary": "^11",
    "spatie/laravel-permission": "^6.16",
    "tightenco/ziggy": "^2.5"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8",
    "pestphp/pest": "^3.5",
    "pestphp/pest-plugin-laravel": "^3.0",
    "spatie/laravel-ignition": "^2"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "autoload": {
    "files": [
      "app/Helpers/index.php"
    ],
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "yarn dlx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan octane:start --host=0.0.0.0 --port=8000 --workers=1 --task-workers=1 --watch\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"yarn dev\" --names=server,queue,logs,vite"
    ],
    "start": [
      "Composer\\Config::disableProcessTimeout",
      "php artisan octane:start --host=0.0.0.0 --port=8000 --workers=1 --task-workers=1 --watch"
    ]
  }
}
